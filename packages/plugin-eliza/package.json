{
  "name": "@dfm-fi/plugin-eliza",
  "version": "0.1.0",
  "description": "ElizaOS 1.x plugin for DFM: every tool of DFM's MCP server (@dfm-fi/agent) as a native Eliza action.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@dfm-fi/mcp-bridge": "^0.1.0"
  },
  "peerDependencies": {
    "@elizaos/core": "^1.0.0"
  },
  "devDependencies": {
    "@elizaos/core": "1.7.2"
  },
  "license": "MIT",
  "author": "DFM <top@dfm.finance>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DFM-Finance/dfm-plugins.git",
    "directory": "packages/plugin-eliza"
  },
  "homepage": "https://github.com/DFM-Finance/dfm-plugins#readme",
  "bugs": {
    "url": "https://github.com/DFM-Finance/dfm-plugins/issues"
  },
  "agentConfig": {
    "pluginType": "elizaos:plugin:1.0.0",
    "pluginParameters": {
      "DFM_API_KEY": {
        "type": "string",
        "description": "Optional revocable dfm_ API key. Only used for writes.",
        "required": false,
        "sensitive": true
      },
      "DFM_AGENT_WRITE_ENABLED": {
        "type": "string",
        "description": "Set to true to allow write tools. Unset = read-only.",
        "required": false
      }
    }
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dfm",
    "solana",
    "elizaos",
    "plugin",
    "mcp",
    "defi"
  ],
  "publishConfig": {
    "access": "public"
  }
}
